javascript:(async()=>{const V=location.host==='webvpn.jnu.edu.cn';const B=(V?'/https/77726476706e69737468656265737421fcfe4395247e625e6b468ca88d1b203b':'')+'/portal-api/space/portal/reservation/',q=V?'?vpn-12-o2-libic.jnu.edu.cn':'?';const k=Object.keys(localStorage).find(x=>x.endsWith('ic-web-access-token'));const T=k&&localStorage.getItem(k);if(!T)return alert('没找到登录 token：请先在预约页面登录并刷新一次再点');const H={'Authorization':'Bearer '+T};const d=new Date();let n=2-d.getDay();if(n<=0)n+=7;d.setDate(d.getDate()+n);const D=d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0');if(!confirm('预约 研修间405 '+D+' 08:00-22:00 ？'))return;try{const p=await(await fetch(B+'precheck'+q+'&spaceId=22&roomId=226&startDate='+D+'&startHour=8',{credentials:'include',headers:H})).json();if(p.code===401)return alert('token 已过期：刷新一下预约页面后再点');if(p.code!==0||!p.data||!p.data.eligible)return alert('预检未通过：'+JSON.stringify(p));const r=await(await fetch(B+'create'+q,{method:'POST',credentials:'include',headers:{...H,'Content-Type':'application/json'},body:JSON.stringify({spaceId:22,roomId:226,startTime:D+' 08:00:00',endTime:D+' 22:00:00',reason:'学习'})})).json();alert(r.code===0?'预约成功，编号 '+r.data:'失败：'+(r.msg||JSON.stringify(r)))}catch(e){alert('请求出错：'+e)}})();
